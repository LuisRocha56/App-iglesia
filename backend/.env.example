# Variables locales para el API.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/mi_iglesia
JWT_SECRET=reemplaza-esto-por-una-clave-aleatoria-larga
FRONTEND_ORIGIN=http://localhost:5500
# Opcional: promueve una cuenta existente a Master una sola vez.
MASTER_EMAIL=
# JSON de la cuenta de servicio; guárdalo como secreto en Render, no en Git.
GOOGLE_SERVICE_ACCOUNT_JSON=
# WhatsApp Cloud API: crea/aprueba una plantilla con cuatro variables de cuerpo.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=mi_iglesia_asignacion
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
# Mientras tenga valor, todas las notificaciones se dirigen a este número de prueba.
WHATSAPP_TEST_RECIPIENT=8182012236
